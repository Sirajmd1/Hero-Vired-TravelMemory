[{"/home/ubuntu/TravelMemory/frontend/src/index.js":"1","/home/ubuntu/TravelMemory/frontend/src/App.js":"2","/home/ubuntu/TravelMemory/frontend/src/reportWebVitals.js":"3","/home/ubuntu/TravelMemory/frontend/src/components/UIC/Header.js":"4","/home/ubuntu/TravelMemory/frontend/src/components/pages/Home.js":"5","/home/ubuntu/TravelMemory/frontend/src/components/pages/AddExperience.js":"6","/home/ubuntu/TravelMemory/frontend/src/components/pages/ExperienceDetails.js":"7","/home/ubuntu/TravelMemory/frontend/src/url.js":"8","/home/ubuntu/TravelMemory/frontend/src/components/UIC/Card.js":"9","/home/ubuntu/TravelMemory/frontend/src/components/UIC/FeaturedCard.js":"10"},{"size":492,"mtime":1770020780985,"results":"11","hashOfConfig":"12"},{"size":776,"mtime":1770302616927,"results":"13","hashOfConfig":"12"},{"size":362,"mtime":1770020780985,"results":"14","hashOfConfig":"12"},{"size":945,"mtime":1770020780985,"results":"15","hashOfConfig":"12"},{"size":1214,"mtime":1770020780985,"results":"16","hashOfConfig":"12"},{"size":6985,"mtime":1770020780985,"results":"17","hashOfConfig":"12"},{"size":2292,"mtime":1770020780985,"results":"18","hashOfConfig":"12"},{"size":86,"mtime":1770302315138,"results":"19","hashOfConfig":"12"},{"size":745,"mtime":1770020780985,"results":"20","hashOfConfig":"12"},{"size":790,"mtime":1770020780985,"results":"21","hashOfConfig":"12"},{"filePath":"22","messages":"23","suppressedMessages":"24","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"q9ndxa",{"filePath":"25","messages":"26","suppressedMessages":"27","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"28","messages":"29","suppressedMessages":"30","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"31","messages":"32","suppressedMessages":"33","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"34","messages":"35","suppressedMessages":"36","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"37","messages":"38","suppressedMessages":"39","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"40"},{"filePath":"41","messages":"42","suppressedMessages":"43","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"44","messages":"45","suppressedMessages":"46","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"47","messages":"48","suppressedMessages":"49","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"50","messages":"51","suppressedMessages":"52","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/home/ubuntu/TravelMemory/frontend/src/index.js",[],[],"/home/ubuntu/TravelMemory/frontend/src/App.js",["53"],[],"/home/ubuntu/TravelMemory/frontend/src/reportWebVitals.js",[],[],"/home/ubuntu/TravelMemory/frontend/src/components/UIC/Header.js",[],[],"/home/ubuntu/TravelMemory/frontend/src/components/pages/Home.js",[],[],"/home/ubuntu/TravelMemory/frontend/src/components/pages/AddExperience.js",["54"],[],"import React, { useState } from \"react\";\nimport { baseUrl } from \"../../url\";\nimport axios from \"axios\";\n\nexport default function AddExperience() {\n  const [loading, setLoading] = useState(false)\n    const [formdata, setFormdata] = useState({\n            tripName: \"\",\n            startDateOfJourney: \"\",\n            endDateOfJourney: \"\",\n            nameOfHotels: \"\",\n            placesVisited: \"\",\n            totalCost: 0,\n            experience: \"\",\n            image: \"\",\n            tripType: \"\",\n            featured: false,\n            shortDescription: \"\"\n    })\n    const submitForm = () => {\n        setLoading(true);\n        console.log(formdata)\n        axios.post(`${baseUrl}/trip`, formdata)\n        setLoading(false)\n    }\n\n    if(loading==true){\n      return(\n        <div>Loading...</div>\n      )\n    }else{\n      return (\n        <div style={{ margin: \"2%\" }}>\n          <div class=\"mb-3\">\n            <label for=\"tripName\" class=\"form-label\">\n              Trip Name\n            </label>\n            <input\n              type=\"text\"\n              class=\"form-control\"\n              id=\"tripName\"\n              placeholder=\"Add your Trip Name\"\n              value={formdata.tripName}\n              onChange={(e) => setFormdata({...formdata, tripName: e.target.value})}\n            ></input>\n          </div>\n          <div class=\"mb-3\">\n            <label for=\"tripDate\" class=\"form-label\">\n              Trip Date\n            </label>\n            <div class=\"row\">\n              <div class=\"col-6\">\n                <input type=\"date\" class=\"form-control\" id=\"startDate\"\n                value={formdata.startDateOfJourney}\n                onChange={(e)=> setFormdata({...formdata, startDateOfJourney: e.target.value})}\n                ></input>\n              </div>\n              <div class=\"col-6\">\n                <input type=\"date\" class=\"form-control\" id=\"endDate\"\n                value={formdata.endDateOfJourney}\n                onChange={(e)=> setFormdata({...formdata, endDateOfJourney: e.target.value})}\n                ></input>\n              </div>\n            </div>\n          </div>\n          <div class=\"mb-3\">\n            <label for=\"nameOfHotels\" class=\"form-label\">\n              Name of Hotels\n            </label>\n            <input\n              type=\"text\"\n              class=\"form-control\"\n              id=\"nameOfHotels\"\n              placeholder=\"Add your Hotel Name\"\n              value={formdata.nameOfHotels}\n            onChange={(e)=> setFormdata({...formdata, nameOfHotels: e.target.value})}\n            ></input>\n          </div>\n          <div class=\"mb-3\">\n            <div class=\"row\">\n              <div class=\"col-6\">\n                <label for=\"nameOfHotels\" class=\"form-label\">\n                  Trip Type\n                </label>\n                <select class=\"form-select\" id=\"tripType\" aria-label=\"tripType\"\n                value={formdata.tripType}\n                onChange={(e)=> setFormdata({...formdata, tripType: e.target.value})}\n                >\n                  <option selected value=\"select\">\n                    Select One\n                  </option>\n                  <option value=\"backpacking\">Backpacking</option>\n                  <option value=\"leisure\">Leisure</option>\n                  <option value=\"business\">Business</option>\n                </select>\n              </div>\n              <div class=\"col-6\">\n                <label for=\"totalCost\" class=\"form-label\">\n                  Total Cost\n                </label>\n                <input\n                  type=\"number\"\n                  class=\"form-control\"\n                  id=\"totalCost\"\n                  placeholder=\"99999\"\n                  value={formdata.totalCost}\n                onChange={(e)=> setFormdata({...formdata, totalCost: e.target.value})}\n                ></input>\n              </div>\n            </div>\n          </div>\n          <div class=\"mb-3\">\n            <label for=\"placesVisited\" class=\"form-label\">\n              Places Visited\n            </label>\n            <input\n              type=\"text\"\n              class=\"form-control\"\n              id=\"placesVisited\"\n              placeholder=\"Delhi, Paris, London, etc.\"\n              value={formdata.placesVisited}\n                onChange={(e)=> setFormdata({...formdata, placesVisited: e.target.value})}\n            ></input>\n          </div>\n          <div class=\"mb-3\">\n            <label for=\"featured\" class=\"form-label\">\n              Featured Trip?\n            </label>\n            <div class=\"form-check\">\n              <input\n                type=\"radio\"\n                class=\"form-check-input\"\n                id=\"true\"\n                value={true}\n                onChange={(e)=> setFormdata({...formdata, featured: JSON.parse(e.target.value)})}\n                checked={formdata.featured === true}\n              ></input>\n              <label>True</label>\n            </div>\n            <div class=\"form-check\">\n              <input\n                type=\"radio\"\n                class=\"form-check-input\"\n                id=\"false\"\n                value={false}\n                onChange={(e)=> setFormdata({...formdata, featured: JSON.parse(e.target.value)})}\n                checked={formdata.featured === false}\n              ></input>\n              <label>False</label>\n            </div>\n          </div>\n          <div class=\"mb-3\">\n            <label for=\"image\" class=\"form-label\">\n              Image Link\n            </label>\n            <input\n              type=\"text\"\n              class=\"form-control\"\n              id=\"image\"\n              placeholder=\"http://xyz.com/image.png\"\n              value={formdata.image}\n            onChange={(e)=> setFormdata({...formdata, image: e.target.value})}\n            ></input>\n          </div>\n          <div class=\"mb-3\">\n            <label for=\"shortDescription\" class=\"form-label\">\n              Short Description\n            </label>\n            <textarea\n              class=\"form-control\"\n              id=\"shortDescription\"\n              rows=\"2\"\n              placeholder=\"Write Short Description\"\n              value={formdata.shortDescription}\n                onChange={(e)=> setFormdata({...formdata, shortDescription: e.target.value})}\n            ></textarea>\n          </div>\n          <div class=\"mb-3\">\n            <label for=\"experience\" class=\"form-label\">\n              Experience\n            </label>\n            <textarea\n              class=\"form-control\"\n              id=\"experience\"\n              rows=\"5\"\n              placeholder=\"Write Complete Details about your experience in the trip.\"\n              value={formdata.experience}\n                onChange={(e)=> setFormdata({...formdata, experience: e.target.value})}\n            ></textarea>\n          </div>\n          <div class=\"mb-3\" style={{ textAlign: \"center\"}}>\n            <button type=\"submit\" class=\"btn btn-primary\" onClick={submitForm}>Submit</button>\n          </div>\n        </div>\n      );\n    }\n\n  \n}\n","/home/ubuntu/TravelMemory/frontend/src/components/pages/ExperienceDetails.js",[],[],"/home/ubuntu/TravelMemory/frontend/src/url.js",[],[],"/home/ubuntu/TravelMemory/frontend/src/components/UIC/Card.js",[],[],"/home/ubuntu/TravelMemory/frontend/src/components/UIC/FeaturedCard.js",[],[],{"ruleId":"55","severity":1,"message":"56","line":1,"column":8,"nodeType":"57","messageId":"58","endLine":1,"endColumn":12},{"ruleId":"59","severity":1,"message":"60","line":27,"column":15,"nodeType":"61","messageId":"62","endLine":27,"endColumn":17},"no-unused-vars","'logo' is defined but never used.","Identifier","unusedVar","eqeqeq","Expected '===' and instead saw '=='.","BinaryExpression","unexpected"]